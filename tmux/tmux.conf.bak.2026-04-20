# plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
# vim sensible options
set -g display-time 4000
set -g status-keys emacs
# set true color
set-option -sa terminal-overrides ",xterm*:Tc"
# set prefix
unbind C-b
set -g prefix C-j
bind C-j send-prefix
# for reloading tmux config
unbind r
bind r source-file ~/.config/tmux/tmux.conf \; display "Config reloaded!"
# for pane movement
bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R
# splits
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
# status position to top
set-option -g status-position top
# renumber windows
set -g base-index 1
set -g pane-base-index 1
set-window-option -g renumber-windows on
# status bars
set -g status-style fg=white,bg=black
# left status bar
set -g status-left "#[fg=green][#S]"
# right status bar
set -g status-right '#{?window_bigger,[#{window_offset_x}#,#{window_offset_y}] ,} %H:%M %d-%b-%y'
# pane status bar
set -g pane-border-status off
set -g pane-border-format "(#{pane_index}: #{pane_current_path})"
# visible only if number of panes > 1
set-hook -g window-layout-changed 'set-window -F pane-border-status "#{?#{>:#{window_panes},1},top,off}"'
set-hook -g pane-exited 'set-window -F pane-border-status "#{?#{>:#{window_panes},1},top,off}"'
# middle bar
set -g status-justify centre
setw -g window-status-format "#[fg=white,bg=default] #I:#W "
setw -g window-status-current-format "#[fg=black,bg=green,bold] #I:#W "
# mouse support
set -g mouse on
# run tpm
run '~/.config/tmux/plugins/tpm/tpm'
